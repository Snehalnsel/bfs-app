<%- include('../../public/assets/include/header'); %>

<section class="dashboard-wrapper">
    <div class="dashboard-container">
       <div class="dashboard-sidbar">
         <div class="sidbar-box user-profile">
            <div class="user-icon">
               <img src="<%=websiteUrl%>/public/compress_images/<%= respdata && respdata.image ? respdata.image : '/default-image.jpg' %>" alt="user-image">
            </div>
            <div class="user-info">
               <div class="sht-ui">Hello</div>
               <div class="user-name"><%=respdata.title%> <%=respdata.name%> </div>
                <div class="userimage-edit">
                <label>
                    <a href="javascript:void(0)" data-toggle="modal" data-target="#upload-profile-modal" class="edit_link">
                       Edit
                    </a>
                </label>
             </div>
            </div>
         

            <div class="modal theme_modal short-modal change-profile-update" id="upload-profile-modal">
               <div class="modal-dialog">
                  <button type="button" class="close" data-dismiss="modal">&times;</button>
                  <div class="modal-content">
                     <div class="loginform-box short-box">
                        <h5 class="box-title">Change Profile Picture</h5>
                        <form action="/change-profile-image-web" method="POST" enctype="multipart/form-data">
                             <div class="inner-formbox">
                                <div class="profile-chnage-box">
                                   <div class="user-icon">
                                      <img src="<%=respdata.image%>" alt="user-image" id="output">                            
                                   </div>
                                   <input id="file" class="" name="pro_img" type="file"/>
                                   <input id="user_id" class="" name="user_id" type="hidden" value="<%=respdata.userId%>"/>
                                   <input class="update-btn" type="submit" value="Update Profile" />
                                </div>
                             </div>
                        </form>
                     </div>
                  </div>
               </div>
            </div>            
         </div>
         <div class="sidbar-box sidbar-nav">
            <ul class="nav d-flex flex-column mb-2 ">
                      <li class="nav-item">
                        <a class="nav-link" href="/my-account"><i class="fa fa-user" aria-hidden="true"></i> <span>Profile</span></a>
                      </li>
                      <li class="nav-item">
                        <a class="nav-link" href="/web-my-order"><i class="fa fa-list-ul" aria-hidden="true"></i> <span>My Orders</span></a>
                      </li>
        
                      <li class="nav-item">
                        <a class="nav-link" href="/my-post/<%=userData.userId%>"><i class="fa fa-file-image-o" aria-hidden="true"></i> <span>My Product</span></a>
                      </li>

                      <li class="nav-item">
                        <a class="nav-link" href="/bank-details"><i class="fa fa-bank" aria-hidden="true"></i>
                           <span>My Bank Details</span></a>
                      </li>
        
                      <li class="nav-item">
                        <a class="nav-link" href="/bid-for-product"><i class="fa fa-arrow-circle-o-right" aria-hidden="true"></i> <span>My Bids</span></a>
                      </li>
                      
                    </ul>
                    <div class="bottom-link">
                     <ul class="nav d-flex flex-column mb-2 ">
                        <li><a class="nav-link" href="/sign-out"><i class="fa fa-sign-out" aria-hidden="true"></i> <span>Sign Out</span></a></li>
                     </ul>
        
                       
                    </div>
        
         </div>        
       </div>
       <div class="dashboard-content">
          <div class="dashboard-infobox">
             
             <div class="dsh-shortbox">
                <form action="" method="post" id="editBankDetails" class="editBankDetails" enctype="multipart/form-data">
                   <div class="div-row">
                     <div class="dashboard-infobox mt-50" >
                        <div class="dashboard-title-arrow mb-25">
                           <h4 class="di-title mr-25" id="bankDetails">Bank Deatils<i class="fa fa-angle-down" style="font-size:24px"></i> </h4>              
                        </div>
                        
                        <div class="dsh-shortbox" id="" style="display:block;">
                            <form id="resetpasswordfrom">
                              <div class="div-row">
                                 <div class="div-6">
                                    <label>Bank Name</label>
                                    <input type="text" name="bankname" class="ds-form-control bankname" id="bankname" value="<% if(bankDetails != null){ %><%=bankDetails.bankname%><% } %>">
                                 </div>
            
                                 <div class="div-6">
                                    <label>Branch Name:</label>
                                    <input type="text" name="branch" class="ds-form-control branch" id="branch" value="<% if(bankDetails != null){ %><%=bankDetails.branchname%><% } %>">
                                    <!-- <input type="text" name="branchname" id="branchname" class="ds-form-control account number branchname" value="<% if(bankDetails != null){ %><%= bankDetails.branchname %><% } %>"> -->
                                 </div>

                                 <div class="div-6">
                                    <label>Account Holder Name:</label>
                                    <input type="text" name="accountname" id="accountname" class="ds-form-control accountname" value="<% if(bankDetails != null){ %><%= bankDetails.accountname %><% } %>">
                                 </div>

                                 <div class="div-6">
                                    <label>Account Number:</label>
                                    <input type="text" name="accountnumber" class="ds-form-control accountnumber" value="<% if(bankDetails != null){ %><%=bankDetails.accountnumber%><% } %>">
                                 </div>
            
                                 <div class="div-6">
                                    <label>IFSC CODE:</label>
                                    <input type="text" name="ifsccode" id="ifsccode" class="ds-form-control ifsccode" value="<% if(bankDetails != null){ %><%= bankDetails.ifsccode %><% } %>">
                                 </div>

                                 <div class="div-6">
                                    <label>Account Type:</label>
                                    <select name="accounttype" id="accounttype" class="ds-form-control">
                                       <option value="savings" <% if(bankDetails != null && bankDetails.accounttype == 'savings'){ %>selected<% } %> >Savings Account</option>
                                       <option value="current" <% if(bankDetails != null && bankDetails.accounttype == 'current'){ %>selected<% } %>>Current Account</option>
                                    </select>
                                 </div>

                                 <div class="div-6">
                                    <label>UPI ID:</label>
                                    <input type="text" name="upiid" id="upiid" class="ds-form-control upiid" value="<% if(bankDetails != null){ %><%= bankDetails.upiid %><% } %>">
                                 </div>

                                 <div class="div-6">
                                    <label>UPI ID SCANER:</label>
                                    <input type="file" name="upiscaner" id="upiscaner" class="upiscaner" value="<% if(bankDetails != null){ %><%= bankDetails.upiscaner %><% } %>"/>
                                 </div>
                              </div>
                           </form>
                           <div class="success-error">
                              <div id="success-bank-msg"></div>
                              <div id="error-bank-msg"></div>
                           </div>
                        </div>
                        
                     </div> 
                      <div class="div-12">
                         <input type="submit" name="" class="ds-form-control" value="Save">
                      </div>
                   </div>
                </form>
                
             </div>
             
          </div> 
 
       </div>
    </div>
 </section>
 <%- include('../../public/assets/include/newsletter'); %>
<%- include('../../public/assets/include/footer'); %>

</body>
<script src="/public/assets/js/bank-details.js"></script>