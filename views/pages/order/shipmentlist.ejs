<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../../partials/head', {pageTitle: pageTitle}); %>
</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <%- include('../../partials/sidebar', {siteName: siteName}); %>
            <!-- End of Sidebar -->

            <!-- Content Wrapper -->
            <div id="content-wrapper" class="d-flex flex-column">

                <!-- Main Content -->
                <div id="content">

                    <!-- Topbar -->
                    <%- include('../../partials/header', {siteName: siteName, userFullName: userFullName, userImage:
                        userImage}); %>
                        <!-- End of Topbar -->

                        <!-- Begin Page Content -->
                        <div class="container-fluid">

                            <!-- Page Heading -->
                            <h1 class="h3 mb-2 text-gray-800"><%-pageName%></h1>
                            <p class="mb-4">View / edit <%-pageName%> details</p>

                            
                            <div class="card shadow mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-primary"><%-pageName%> Details</h6>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                                            <thead>
                                                <tr>
                                                    <th>Sl No</th>
                                                    <th>Shipping Id</th>
                                                    <th>Order Id</th>
                                                    <th>Product Name</th>
                                                    <th>Buyer Details</th>
                                                    <th>Hub Details</th>
                                                    <th>Payment Method</th>
                                                    <th>Total Price</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if(respdata.list){ %>
                                                    <% respdata.list.forEach(function(value, index) { %>
                                                        <tr>
                                                            <td>
                                                                <%= (index+1) %>
                                                            </td>
                                                            <td>
                                                                <%= value.track_code != null ? value.track_code : " " %>
                                                            </td>
                                                            <td>
                                                                <%= value.order_id != null && value.order_id.order_code != null ? value.order_id.order_code : " " %>
                                                            </td>
                                                            <td>
                                                                <%= value.product_id != null && value.product_id.name != null ? value.product_id.name : " " %>
                                                            </td>
                                                            <td>
                                                                <%= value.buyer_id != null && value.buyer_id.name != null ? value.buyer_id.name : " " %> 
                                                                <%= value.buyer_id != null && value.buyer_id.phone_no != null ? value.buyer_id.phone_no : " " %>
                                                                <%= value.buyer_id != null && value.buyer_id.email != null ? value.buyer_id.email : " " %>
                                                                <br>
                                                                <%= value.shipping_address_id != null && value.shipping_address_id.street_name != null ? value.shipping_address_id.street_name : " " %>,
                                                                <%= value.shipping_address_id != null && value.shipping_address_id.address1 != null ? value.shipping_address_id.address1 : " " %>,
                                                                <%= value.shipping_address_id != null && value.shipping_address_id.landmark != null ? value.shipping_address_id.landmark : " " %>,
                                                                <%= value.shipping_address_id != null && value.shipping_address_id.city_name != null ? value.shipping_address_id.city_name : " " %>,
                                                                <%= value.shipping_address_id != null && value.shipping_address_id.state_name != null ? value.shipping_address_id.state_name : " " %>
                                                            </td>
                                                            <td>
                                                                <%= value.hub_address_id != null && value.hub_address_id.name != null ? value.hub_address_id.name : " " %> 
                                                                <%= value.hub_address_id != null && value.hub_address_id.phone_no != null ? value.hub_address_id.phone_no : " " %>
                                                                <%= value.hub_address_id != null && value.hub_address_id.email != null ? value.hub_address_id.email : " " %>
                                                                <br>
                                                                <%= value.hub_address_id != null && value.hub_address_id.street_name != null ? value.hub_address_id.street_name : " " %>,
                                                                <%= value.hub_address_id != null && value.hub_address_id.address1 != null ? value.hub_address_id.address1 : " " %>,
                                                                <%= value.hub_address_id != null && value.hub_address_id.landmark != null ? value.hub_address_id.landmark : " " %>,
                                                                <%= value.hub_address_id != null && value.hub_address_id.city_name != null ? value.hub_address_id.city_name : " " %>,
                                                                <%= value.hub_address_id != null && value.hub_address_id.state_name != null ? value.hub_address_id.state_name : " " %>
                                                            </td>
                                                            <td>
                                                                <span style="color: #98FB98;">Online</span>
                                                            </td>
                                                            <td>
                                                                <%= value.total_price != null ? value.total_price : " " %>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                            <% } %>
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- /.container-fluid -->

                </div>
                <!-- End of Main Content -->

                <!-- Footer -->
                <%- include('../../partials/footer', {year: year, siteName: siteName}); %>
                    <!-- End of Footer -->

            </div>
            <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->

    <%- include('../../partials/logoutModal'); %>

        <%- include('../../partials/footerJs'); %>

</body>

</html>

<script>
    $(document).ready(function () {
        $('#dataTable').DataTable({
            "paging": true,
            "ordering": true,
            "searching": true
        });
    });
</script>