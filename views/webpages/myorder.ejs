                        <a class="nav-link" href="/web-my-order"><i class="fa fa-list-ul" aria-hidden="true"></i>
                           <span>My Orders</span></a>
                     </li>
                     <li class="nav-item">
                        <% if(respdata !=null && typeof respdata !="undefined" && typeof respdata.userId !="undefined" )
                           {%>
                           <a class="nav-link" href="/my-post/<%=respdata.userId%>"><i class="fa fa-file-image-o"
                                 aria-hidden="true"></i> <span>My Product</span></a>
                           <% } %>
                     </li>
                     <li class="nav-item">
                        <a class="nav-link" href="/bank-details"><i class="fa fa-bank" aria-hidden="true"></i>
                           <span>My Bank Details</span></a>
                      </li>
                     <li class="nav-item">
                        <a class="nav-link" href="/bid-for-product"><i class="fa fa-arrow-circle-o-right"
