<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../../partials/head', {pageTitle: pageTitle}); %>
</head>

<body id="page-top">

  <!-- Page Wrapper -->
  <div id="wrapper">

    <!-- Sidebar -->
    <%- include('../../partials/sidebar', {siteName: siteName}); %>
    <!-- End of Sidebar -->

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">

      <!-- Main Content -->
      <div id="content">

        <!-- Topbar -->
        <%- include('../../partials/header', {siteName: siteName, userFullName: userFullName, userImage: userImage}); %>
        <!-- End of Topbar -->

        <!-- Begin Page Content -->
        <div class="container-fluid">

          <!-- Page Heading -->
          <h1 class="h3 mb-2 text-gray-800"><%-pageName%></h1>
          <p class="mb-4">View / edit <%-pageName%> details</p>

          <!-- DataTales Example -->
          <div class="card shadow mb-4">
            <div class="card-header py-3">
              <h6 class="m-0 font-weight-bold text-primary"><%-pageName%> Details</h6>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                  <thead>
                    <tr>
                      <th>Sl No</th>
                      <th>Product Name</th>
                      <th>Product Image</th>
                      <th>Original Price</th>
                      <th>Total Number Of Bidar</th>
                      <th>Buyer Name</th>
                      <th>Seller Name</th>
                      <th>Buyer Price</th>
                      <th>Seller Price</th>
                      <!-- <th>Final Price</th> -->
                      <!-- <th>Status</th>
                      <th>Chat Status</th> -->
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if(respdata.list){ %>
                    <% respdata.list.forEach(function(value, index) { %>
                    <tr>
                      <td><%= (index+1) %></td>
                      <td><%= value.productName%></td>
                      <td><img src="<%= value.productImage%>" style="height: 100px; width:100px;"></td>
                      <td><i class="fa fa-inr" aria-hidden="true"></i> <%= value.original_price%></td>
                      <td><%= value.no_of_bidars%></td>
                      <td><%= value.buyerName %></td>
                      <td><%= value.sellerName%></td>
                      <td><i class="fa fa-inr" aria-hidden="true"></i> <%= value.buyer_price%></td>
                      <td><i class="fa fa-inr" aria-hidden="true"></i> <%= value.seller_price%></td>
                      <!-- <td><%= value.final_price%></td> -->
                      <!-- <td>
                        <% if (value.status === 0) { %>
                        <span style="color: blue;">Pending</span>
                        <% } else if (value.status === 1) { %>
                        <span style="color: green;">Approved</span>
                        <% } else if (value.status === 2) { %>
                        <span style="color: red;">Rejected</span>
                        <% } else { %>
                        Unknown
                        <% } %>
                      </td> -->
                      <!-- <td>
                        <% if (value.chat_status === 0) { %>
                        <span style="color: blue;">Counter</span>
                        <% } else if (value.chat_status === 1) { %>
                        <span style="color: green;">Yes</span>
                        <% } else if (value.chat_status === 2) { %>
                        <span style="color: red;">No</span>
                        <% } else { %>
                        Unknown
                        <% } %>
                      </td> -->
                      <td>
                        <!-- <button type="button" class="btn btn-info btn-lg"
                          onclick="bidModalOpen('<%= value.product_id%>')">Open
                          Modal</button> -->

                        <a href="javascript:void(0)" class="btn btn-info "
                          onclick="bidModalOpen('<%= value.product_id%>')" title="View">
                          <i class="fas fa-eye"></i>
                        </a>
                        <!-- <a href="/admin/biddetails/<%= value._id %>" class="btn btn-info btn-circle btn-sm"
                          title="Edit">
                          <i class="fas fa-pencil-alt"></i>
                        </a>
                        <a href="/admin/delete-biddetails/<%= value._id %>" class="btn btn-danger btn-circle btn-sm"
                          title="Delete">
                          <i class="fas fa-trash"></i>
                        </a> -->
                      </td>
                    </tr>
                    <% });  %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <!-- /.container-fluid -->

        <!--  =====Modal staet=== -->
        <div class="modal fade" id="bidModalSet" role="dialog">
          <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content">
              <div class="modal-header">
                <!-- <button type="button" class="close" data-dismiss="modal">&times;</button> -->
                <h4 class="modal-title">Bid History</h4>
              </div>
              <div class="modal-body">
                <div id="bidPush">
                  <h4>Loading..</h4>

                </div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
              </div>
            </div>

          </div>
        </div>

        <!-- =====Modal End==== -->

      </div>
      <!-- End of Main Content -->











      <!-- Footer -->
      <%- include('../../partials/footer', {year: year, siteName: siteName}); %>
      <!-- End of Footer -->

    </div>
    <!-- End of Content Wrapper -->

  </div>
  <!-- End of Page Wrapper -->

  <!-- Scroll to Top Button-->
  <a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
  </a>

  <!-- Logout Modal-->

  <%- include('../../partials/logoutModal'); %>

  <%- include('../../partials/footerJs'); %>

</body>

</html>
<script>

  function bidModalOpen(productId) {
    $("#bidModalSet").modal();
    $('#bidPush').html('<h4> Loading..</h4>');
    $.ajax({
      type: "POST",
      url: 'getBidDetailsAjax',
      data: { product_id: productId },
      cache: false,
      success: function (response) {
        //console.log("response--", response)
        if (response.status == 'success') {
          let html = '';
          html += `<h5>Product Name:- ${response.product_info.productName} </h5>`;
          html += '<table border="1" style="font-family: Arial, Helvetica, sans-serif;border-collapse: collapse;width: 100%;">';
          html += '<tr>';
          html += '<th>Bid By</th>';
          html += '<th>Name</th>';
          html += '<th>Price</th>';
          html += "<th>Associated Buyer's Name </th>";
          html += "<th>Accepted Status</th>";
          html += '</tr>';
          for (let bidVal of response.product_bid_list) {
            html += '<tr>';
            html += `<td> ${bidVal.bid_by} </td>`;
            html += `<td>${bidVal.name}</td>`;
            html += `<td><i class="fa fa-inr" aria-hidden="true"></i> ${bidVal.price}</td>`;
            html += `<td>${bidVal.associated_buyer}</td>`;
            html += `<td>${bidVal.accepted_status}</td>`;
            html += '</tr>';
          }
          html += '</table>';

          $('#bidPush').html(html);
        } else {
          alert(response.message)
        }
      },
    });
  }
</script>

<script>
  $(document).ready(function () {
    $('#dataTable').DataTable({
      "paging": true,
      "ordering": true,
      "searching": true
    });
  });
</script>