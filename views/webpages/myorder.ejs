   </section>

   <div class="modal theme_modal short-modal" id="short-modal">
      <div class="modal-dialog">
         <button type="button" class="close" data-dismiss="modal">&times;</button>
         <div class="modal-content">
            <div class="short-box buy-modal">

               <table class="table table-borderless highlight-first-td">  
                  <tbody>
                    <tr> 
                        <td>Shipping Kit </td>
                        <th><i class="fa fa-inr" aria-hidden="true"></i>12000.00</th> 
                      </tr>
                        <td>GST</td>
                        <th><i class="fa fa-inr" aria-hidden="true"></i>210.00</th> 
                      </tr>
                      <tr class="border-top total-table">
                        <td><strong>Total Amount</strong></td>
                        <th><i class="fa fa-inr" aria-hidden="true"></i>12960.00</th> 
                      </tr>
                  </tbody>
               </table>
               <!-- <h5 class="box-title">Shipping Kit <span><i class="fa fa-inr" aria-hidden="true"></i>350 + GST</span>
               </h5> -->
               <p>(Contains Manifest, Tax Invoice, Shipping Label, Bubble Insulation, Courier Bag)</p>
               <p class="text-center"><a href="javascript:void(0)" class="acb-btn order-shipping-kit  modal-short-btn">Buy Shipping
                     Kit</a></p>
            </div>
         </div>
      </div>
   </div>
   <%- include('../../public/assets/include/newsletter'); %>
      <%- include('../../public/assets/include/footer'); %>

         </body>

         <script>
            window.onload = fetchData();
            window.onload = sellerList();
         
            async function fetchData() {
         
               const orderList = await fetch('/orderlist', {
                  method: 'POST',
                  headers: {
                     'Content-Type': 'application/json'
                  }
               });
               const orderListData = await orderList.json();

               populateBuyerHtml(orderListData);
            }

            function populateBuyerHtml(data) {

               data.orders.forEach(item => {
                  let currImagesUrl = `/public/images/${item.product.image}`;
                  var hTml = `<div class="cart-list wishlist-list" data-orderid="${item._id}" data-userby="3">
        <div class="bids-row wishlist-row " >
              <div class="br-details">
                  <div class="bid-images">
                     <a href="/productdeatils/${item.product.id}"><img src="${(currImagesUrl.startsWith('/public/compress_images/') ? (webSiteUrl + '/public/compress_images/' + item.product.image) : webSiteUrl + currImagesUrl)}" alt="images" class="img-fluid"></a>
                  </div>
                  <div class="bid-info">
                     <div class="bd-title">
                        <a href="/productdeatils/${item.product.id}">${item.product.name}</a>
                     </div>
                     <div class="bd-price">
                        <span><i class="fa fa-inr" aria-hidden="true"></i></span>${item.total_price}
                     </div>                                         
                  </div>
                </div>

                <div class="br-results two-rowbox ">                                            
                              <div class="cart-action d-flex">
                                 <div class=" rcicon-2 watch-cart">
                                    <a href="/web-myorder-details/${item._id}" class="prd-btn"
                                       data-id=""><i class="fa fa-eye" aria-hidden="true"></i></a>
                                 </div>`;
                  if (item.delete_status == 0 && item.is_return == 0 ) {
                     if(item.isActionShow == 0){
                        hTml += `
                                       <div class="remove-cart ">
                                          <a href="#" class="prd-btn remove-order"
                                             data-id="${item._id}" ><i class="fa fa-trash-o"
                                                aria-hidden="true"></i></a>  
                                       </div>`;
                     }else {
                        hTml += `
                                       <div class="remove-cart otb-hoverbox">
                                          <a href="javascript:void(0)" class="prd-btn"><i class="fa fa-trash-o"
                                                aria-hidden="true"></i></a>
                                                <div class="order-tooltip-box">You can not cancel this order after 24 hours.</div>
                                       </div>`;
                     }
                  }
                  else if (item.delete_status == 1) {
                     if (item.delete_by == 1) {
                        hTml += `
                                          <div class="remove-cart">
                                             <span style="color: blue;">Cancelled By Admin</span>
                                          </div>`;
                     }
                     else if (item.delete_by == 2) {
                        hTml += `
                                          <div class="remove-cart">
                                             <span style="color: rgb(5, 15, 73);">Cancelled By Seller</span>
                                          </div>`;
                     }
                     else if (item.delete_by == 3) {
                        hTml += `
                                          <div class="remove-cart">
                                             <span style="color: rgb(45, 144, 226);">Cancelled By You</span>
                                          </div>`;
                     }
                  }
                  hTml += `   
                              </div>
                              <div class="cart-action d-flex">
                                 <div class="return-cart">`;
                  if (item.is_return == 1) {
                     hTml += `
                  <span style="color: green;">Return placed successfully</span>`;
                  } else if (item.is_return == 0) {
                     if(item.isActionShow == 1){
                           hTml += `
                     <button class="prd-btn return-order" data-id="${item._id}">Return Order</button>`;
                     } else{
                        hTml += `<div class="otb-hoverbox">
                             <button class="prd-btn grey-btn">Return Order</button>
                           <div class="order-tooltip-box">You can place return order within the 24 Hours of the delivery received.</div>
                        </div>`;
                     }
                     
                  }
                  hTml += `
              </div> 
            </div>
          </div>
        </div>
      </div>`;
                  $("#buyers-tab").append(hTml);
               });
            }
            async function sellerList() {

               const sellerList = await fetch('/selllist', {
                  method: 'POST',
                  headers: {
                     'Content-Type': 'application/json'
                  }
               });
               const sellerListData = await sellerList.json();
               populateSellerHtml(sellerListData);
            }

            function populateSellerHtml(data) {
               data.orders.forEach(item => {

                  let currImagesUrl = `/public/images/${item.product.image}`;
                  var hTml = `<div class="cart-list wishlist-list" data-orderid="${item._id}" data-userby="2">
    <div class="bids-row wishlist-row order-list">
        <div class="br-details">
            <div class="bid-images">
               <a href="/productdeatils/${item.product.id}"><img src="${(currImagesUrl.startsWith('/public/compress_images/') ? (webSiteUrl + '/public/compress_images/' + item.product.image) : webSiteUrl + currImagesUrl)}" alt="images" class="img-fluid">
               </a>
            </div>
            <div class="bid-info bi-iconbox">
               <div class="bid-left">
                <div class="bd-title"><a href="/productdeatils/${item.product.id}">${item.product.name}</a></div>
                <div class="bd-price"><span><i class="fa fa-inr" aria-hidden="true"></i></span>${item.total_price}</div>
                <div class="cnbtn-group">`;
                  if (item.shippingkit_status == 1) {
                     hTml += `<p>Shipping kit has already been bought.</p>`;
                  } else if (item.delete_status == 0) {
                     hTml += `
                        <p>Please Choose Either Option To Confirm Your Order.</p>
                        <div class="cg-row">
                           <input type="hidden" name="shipping_charges" value=${item.shipping_charges}>
                           <a href="javascript:void(0)" data-toggle="modal" data-target="#short-modal" class="acb-btn rv-btn buy-shipping-kit" data-orderid="${item._id}">Buy Shipping Kit</a>
                           <a href="javascript:void(0)" class="acb-btn  grey-btn">Don't Buy Shipping Kit</a>
                        </div>
                             `;
                  }
                  hTml += `</div>
                </div>
                <div class="bid-right flx-content">
                  <div class="remove-cart">
                     <a href="/web-myorder-details/${item._id}"><i class="fa fa-info-circle"></i></a>  
                   </div>`;
                  if (item.delete_status == 0) {
                     hTml += `
                   <div class="remove-cart">
                     <a href="javascript:void(0)" id="erase" class ="remove-order"><i class="fa fa-trash-o"></i></a>  
                   </div> `;
                  }
                  else if (item.delete_status == 1) {
                     if (item.delete_by == 1) {
                        hTml += `
                                       <div class="remove-cart">
                                             <span style="color: blue;">Cancelled By Admin</span>
                                          </div>`;
                     }
                     else if (item.delete_by == 2) {
                        hTml += `
                                          <div class="remove-cart">
                                             <span style="color: rgb(5, 15, 73);">Cancelled By Seller</span>
                                          </div>`;
                     }
                     else if (item.delete_by == 3) {
                        hTml += `
                                          <div class="remove-cart">
                                             <span style="color: rgb(45, 144, 226);">Cancelled By You</span>
                                          </div>`;
                     }
                  }
                  hTml += `
                </div>
                     </div>
                     </div>
                     </div></div>`;
                  $("#viewers-tab").append(hTml);
               });
            }
            $(document).on('click', '.buy-shipping-kit', function () {
               var orderId = $(this).data('orderid');
               var shippingCharges = parseFloat($('input[name="shipping_charges"]').val()); 
               $('.short-modal .buy-modal table.highlight-first-td tbody tr:eq(0) th').html(`<i class="fa fa-inr" aria-hidden="true"></i>${shippingCharges.toFixed(2)}`);
               var gst = shippingCharges * 0.28;
               var totalAmount = shippingCharges + gst;
               $('.short-modal .buy-modal table.highlight-first-td tbody tr:eq(1) th').html(`<i class="fa fa-inr" aria-hidden="true"></i>${gst.toFixed(2)}`);
               $('.short-modal .buy-modal table.highlight-first-td tbody tr.total-table th').html(`<i class="fa fa-inr" aria-hidden="true"></i>${totalAmount.toFixed(2)}`);
               $('.short-modal .buy-modal a.acb-btn.order-shipping-kit').attr('data-orderid', orderId);
               $('#short-modal').modal('show');
            });
            $(document).on('click', '.order-shipping-kit', function () {
              // var orderId = $(this).data('orderid');
              var orderId = $(this).attr('data-orderid');
               var cgRowElement = $(`.cg-row[data-orderid="${orderId}"]`);
               $.ajax({
                  url: '/get-shipmentkitweb/' + orderId.trim(),
                  method: 'GET',
                  success: function (response) {
                     if (response.is_shippingkit == true) {
                        const tempOrderId = response.ordershippingkit_data._id;
                        window.location.href = '/payshippingkit?temp=' + tempOrderId;
                     }
                     else {
                        Swal.fire({
                           html: response.message,
                           confirmButtonText: "OK",
                           customClass: { confirmButton: 'alert-box-button', popup: 'swal2-popup' }
                        });
                     }
                  },
                  error: function (err) {
                  }
               });
            });
         </script>

         <script src="/public/assets/js/order.js"></script>